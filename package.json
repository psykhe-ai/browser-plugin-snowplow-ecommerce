{
  "name": "@psykhe-ai/browser-plugin-snowplow-ecommerce",
  "version": "0.1.2",
  "description": "Snowplow plugin for tracking ecommerce events on PSYKHE AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "check:snowplow-version": "node scripts/check-snowplow-version.mjs",
    "prebuild": "pnpm check:snowplow-version",
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings=0",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/psykhe-ai/browser-plugin-snowplow-ecommerce.git"
  },
  "author": "PSYKHE AI",
  "dependencies": {
    "@snowplow/browser-tracker-core": "4.5.0",
    "@snowplow/tracker-core": "4.5.0",
    "sha1": "^1.1.1",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "@snowplow/browser-tracker": ">=4.5.0 <5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@snowplow/browser-tracker": "4.5.0",
    "@types/sha1": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "BSD-3-Clause"
}
